# =============================================================================
# SIRIX Frontend (Vite PWA) Environment Configuration
# =============================================================================
#
# Live Google Cloud Run FastAPI Backend URL:
# - Leave EMPTY ("") for the canonical Single-Origin Cloud Run container
#   (when FastAPI serves `/app/static_gui` and `/api/*` from the same `.run.app` origin).
# - Set to your live Cloud Run URL (NO trailing slash) ONLY when hosting the frontend
#   on a separate domain/origin or running Vite dev directly against Cloud Run:
#     VITE_API_URL=https://<service>-<hash>-<region>.a.run.app
VITE_API_URL=

# Legacy alias (read only if VITE_API_URL is empty)
VITE_API_BASE_URL=

# Explicit Sandbox / Mock Telemetry Gate:
# MUST remain "false" in all production/live builds.
# Set to "true" ONLY in dedicated local UI development/testing sessions.
VITE_ENABLE_SANDBOX=false
