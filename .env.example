# =============================================================================
# SIRIX Autonomous Quantitative Platform — Environment Configuration Template
# =============================================================================
# Copy to `.env` for local development. NEVER commit real secrets to Git.

# --- Runtime Mode ---
ENVIRONMENT=production
DRY_RUN=false

# --- Google Cloud Storage (Single Source of Truth) ---
SIRIX_GCS_BUCKET=sirix-quant-state-prod
GCS_BUCKET_NAME=sirix-quant-state-prod

# --- Cloud Run Service & Internal EOD Cache Invalidation ---
SIRIX_CLOUD_RUN_URL=https://<service>-<hash>-<region>.a.run.app
INTERNAL_SCHEDULER_TOKEN=

# --- Frontend Vite Build-Time Variables ---
# Leave VITE_API_URL empty for Single-Origin Cloud Run deployment (recommended).
# Set explicitly to https://<service>-<hash>-<region>.a.run.app only for split-origin hosting.
VITE_API_URL=
VITE_API_BASE_URL=
# MUST remain false in production so the PWA never falls back to mock/sandbox fixtures.
VITE_ENABLE_SANDBOX=false

# --- Optional Split-Origin CORS (leave empty for strict Single-Origin Cloud Run) ---
# Comma-separated allowed frontend origins if hosted separately from Cloud Run:
SIRIX_CORS_ORIGINS=

# --- Authentication & Security (configure via Cloud Run / GitHub Secrets) ---
JWT_SECRET_KEY=
SIRIX_JWT_SECRET=
SIRIX_COOKIE_SECURE=true
SIRIX_DEFAULT_PASSWORD=
ADMIN_PASSWORD_HASH=

# --- Telegram NotificationHub ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
